# SiYuan — Environment Variables
# Copy this file to `.env` and fill in each value before `docker compose up`.
# `.env` is gitignored — never commit real credential values.
#
# The image version is NOT set here. The tested tag + sha256 digest lives in
# the compose file's `x-images` block, so `git pull` delivers the version
# this repository has tested. To pin differently, uncomment:
# SIYUAN_IMAGE_TAG=b3log/siyuan:v3.8.2@sha256:…

# Access code for the workspace — everyone opening the UI must enter it.
# REQUIRED. Generate with:
#     openssl rand -base64 24 | tr -d '/+=' | head -c 32
SIYUAN_AUTH_CODE=change_me_before_first_start

# Timezone inside the container (tz database name). Default shown.
# SIYUAN_TIMEZONE=America/New_York

# Resource limits (defaults shown). Each service carries memory/CPU limits and
# reservations as compose-level defaults; override any of them here and the
# override survives every git pull. Sizing is per host: raise a limit if a
# service is OOM-killed (docker inspect shows OOMKilled=true).
# SIYUAN_MEMORY_LIMIT=512m
# SIYUAN_CPU_LIMIT=1.0
# SIYUAN_MEMORY_RESERVATION=64m
# SIYUAN_CPU_RESERVATION=0.25

# Backup Variables (defaults shown). The backups service copies each SQLite
# database consistently (Python's sqlite3 backup API, no application stop) and
# archives the rest of the data directory on a loop; files land in the
# siyuan-backups volume.
# SIYUAN_BACKUP_INIT_SLEEP=30m
# SIYUAN_BACKUP_INTERVAL=24h
# SIYUAN_BACKUP_PRUNE_DAYS=7
# SIYUAN_BACKUPS_PATH=/srv/siyuan/backups
# SIYUAN_BACKUP_NAME=siyuan-database-backup
# SIYUAN_DATA_BACKUP_NAME=siyuan-data-backup

# Image versions. Every image is pinned by digest inside the compose file
# (x-images block); set the matching variable here to run a different version
# of that one image (Compose then pulls the tag, without a digest) while every
# other pin stays as tested. Setting <PREFIX>_IMAGE_TAG replaces the whole
# reference instead. Needs Docker Compose v2.5 or newer (2022).
# SIYUAN_IMAGE_VERSION=v3.8.2
